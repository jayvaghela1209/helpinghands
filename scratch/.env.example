# FastAPI Backend Environment Variables
PORT=8000

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sahayog

# Supabase Project Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-key
SUPABASE_JWT_SECRET=super-secret-jwt-key

# Platform Operator Credentials
# Generate password hash: python -c "import bcrypt; print(bcrypt.hashpw(b'YourPassword', bcrypt.gensalt()).decode())"
PLATFORM_OPERATOR_EMAIL=operator@helpinghands.org
PLATFORM_OPERATOR_PASSWORD_HASH=
PLATFORM_OPERATOR_JWT_SECRET=platform-operator-secret-change-me
